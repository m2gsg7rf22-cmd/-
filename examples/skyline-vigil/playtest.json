{
  "name": "Skyline Vigil",
  "serveRoot": "../..",
  "quality": "low",
  "steps": [
    { "do": "step", "frames": 30 },
    { "do": "expect", "path": "state", "op": "==", "value": "menu", "label": "title menu on boot" },
    { "do": "screenshot", "name": "01-title" },
    { "do": "call", "fn": "startGame" }, { "do": "step", "frames": 60 },
    { "do": "expect", "path": "state", "op": "==", "value": "playing", "label": "game starts" },
    { "do": "canvas", "label": "city frame renders" },
    { "do": "screenshot", "name": "02-street" },
    { "do": "expect", "path": "player.grounded", "op": "truthy", "label": "hero spawns grounded" },
    { "do": "expect", "path": "enemies", "op": ">=", "value": 9, "label": "three gangs spawned (>= 9 members)" },
    { "do": "step", "frames": 120 },
    { "do": "expect", "js": "window.__GF.game.enemies.every(e => e.state === 'patrol')", "op": "truthy", "label": "gangs hold their corners until the hero approaches" },
    { "do": "eval", "js": "window.__GF.cheat.goTo('npc:rae')" }, { "do": "step", "frames": 6 },
    { "do": "expect", "path": "focus", "op": "==", "value": "npc:rae", "label": "Dispatcher Rae can be approached" },
    { "do": "press", "action": "interact" }, { "do": "step", "frames": 150 },
    { "do": "expect", "path": "state", "op": "==", "value": "dialogue", "label": "talking to Rae opens the briefing" },
    { "do": "screenshot", "name": "03-briefing" },
    { "do": "eval", "js": "for (let i = 0; i < 12 && window.__GF.state().state === 'dialogue'; i++) { window.__GF.press('interact'); window.__GF.press('choice1'); window.__GF.step(150); }" },
    { "do": "expect", "path": "quests.streets", "op": "==", "value": "active", "label": "briefing starts 'Take Back the Streets'" },
    { "do": "expect", "path": "quests.beacons", "op": "==", "value": "active", "label": "briefing starts 'Rooftop Relays'" },
    { "do": "eval", "js": "window.__GF.cheat.launch()" }, { "do": "step", "frames": 2 },
    { "do": "press", "action": "swing", "frames": 50 }, { "do": "step", "frames": 25 },
    { "do": "expect", "path": "traversal.swinging", "op": "truthy", "label": "R attaches a swing line to a building" },
    { "do": "screenshot", "name": "04-swing" },
    { "do": "step", "frames": 30 },
    { "do": "expect", "path": "traversal.swings", "op": ">=", "value": 1, "label": "swing counted" },
    { "do": "eval", "js": "window.__GF.cheat.launch()" }, { "do": "step", "frames": 20 },
    { "do": "hold", "action": "glide" }, { "do": "step", "frames": 40 },
    { "do": "expect", "path": "traversal.gliding", "op": "truthy", "label": "holding Space while falling glides" },
    { "do": "expect", "js": "window.__GF.game.player.ctrl.velocity.y > -3.6", "op": "truthy", "label": "glide limits the sink rate" },
    { "do": "release", "action": "glide" },
    { "do": "press", "action": "dodge", "frames": 2 }, { "do": "step", "frames": 4 },
    { "do": "expect", "path": "traversal.dashes", "op": ">=", "value": 1, "label": "air dash" },
    { "do": "step", "frames": 300 },
    { "do": "expect", "path": "player.alive", "op": "truthy", "label": "hero survives a long fall" },
    { "do": "eval", "js": "window.__GF.cheat.toRoof(0)" }, { "do": "step", "frames": 10 },
    { "do": "expect", "path": "player.grounded", "op": "truthy", "label": "rooftops are walkable" },
    { "do": "press", "action": "interact" }, { "do": "step", "frames": 20 },
    { "do": "expect", "path": "collected", "op": ">=", "value": 1, "label": "a rooftop relay can be activated" },
    { "do": "screenshot", "name": "05-rooftop" },
    { "do": "eval", "js": "for (let i = 1; i < 4; i++) { window.__GF.cheat.toRoof(i); window.__GF.step(10); window.__GF.press('interact'); window.__GF.step(20); }" },
    { "do": "expect", "path": "quests.beacons", "op": "==", "value": "complete", "label": "all four relays complete the quest" },
    { "do": "eval", "js": "window.__GF.cheat.god(); window.__GF.cheat.goToGang(0)" }, { "do": "step", "frames": 150 },
    { "do": "expect", "js": "window.__GF.game.gangs[0].members.some(e => ['chase','attack','circle'].includes(e.state))", "op": "truthy", "label": "approaching a gang triggers combat" },
    { "do": "press", "action": "attack", "frames": 2, "every": 18, "repeat": 25 },
    { "do": "expect", "path": "kills", "op": ">=", "value": 1, "label": "gang members can be defeated in melee" },
    { "do": "screenshot", "name": "06-fight" },
    { "do": "eval", "js": "for (let i = 0; i < 3; i++) window.__GF.cheat.killGang(i)" }, { "do": "step", "frames": 150 },
    { "do": "expect", "path": "quests.streets", "op": "==", "value": "complete", "label": "defeating the gangs completes the streets quest" },
    { "do": "expect", "path": "state", "op": "==", "value": "gameover", "label": "both quests secure downtown (victory)" },
    { "do": "screenshot", "name": "07-victory" }
  ]
}
