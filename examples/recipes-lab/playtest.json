{
  "name": "Recipes Lab",
  "serveRoot": "../..",
  "quality": "low",
  "steps": [
    { "do": "step", "frames": 20 },
    { "do": "call", "fn": "startGame" }, { "do": "step", "frames": 30 },
    { "do": "expect", "path": "state", "op": "==", "value": "playing", "label": "lab boots with all recipe modules installed" },
    { "do": "eval", "js": "window.__GF.cheat.god()" },
    { "do": "expect", "js": "!!window.__GF.game.boss && window.__GF.game.boss.name === 'The Colossus'", "op": "truthy", "label": "recipe: boss spawned" },
    { "do": "eval", "js": "const b = window.__GF.game.boss; b.health.damage(b.health.max * 0.6, {}); b.health.invulnerable = 0" }, { "do": "step", "frames": 10 },
    { "do": "expect", "js": "window.__GF.game.boss.stats.attackCooldown < 2.4 * 0.75", "op": "truthy", "label": "recipe: boss enters phase 2 below 50% hp" },
    { "do": "step", "frames": 400 },
    { "do": "expect", "js": "window.__GF.app.vfx.emitted > 30", "op": "truthy", "label": "recipe: boss slam emits debris" },
    { "do": "eval", "js": "window.__GF.cheat.killAll()" }, { "do": "step", "frames": 30 },
    { "do": "expect", "js": "window.__GF.game.enemies.filter(e => e.alive).length > 0", "op": "truthy", "label": "recipe: next wave spawns after clearing" },
    { "do": "expect", "js": "window.__GF.game.enemies.some(e => e.type === 'knight' && e.alive)", "op": "truthy", "label": "recipe: custom 'knight' archetype used by the wave spawner" },
    { "do": "hold", "action": "sprint" }, { "do": "press", "action": "heavy", "frames": 2 }, { "do": "step", "frames": 4 }, { "do": "release", "action": "sprint" },
    { "do": "expect", "js": "window.__GF.game.player.anim.current && window.__GF.game.player.anim.current.name === 'spinSlash'", "op": "truthy", "label": "recipe: custom pose-function clip plays" },
    { "do": "step", "frames": 60 },
    { "do": "eval", "js": "window.__GF.__a0 = window.__GF.app.audio.played" },
    { "do": "press", "action": "ability", "frames": 2 }, { "do": "step", "frames": 10 },
    { "do": "expect", "js": "window.__GF.app.audio.played > window.__GF.__a0", "op": "truthy", "label": "recipe: projectile weapon fires" },
    { "do": "expect", "js": "window.__GF.app.scene.children.some(o => o.name === 'spire')", "op": "truthy", "label": "recipe: lofted hero landmark placed" },
    { "do": "expect", "js": "window.__GF.app.scene.children.some(o => o.isPoints && o.geometry.attributes.position.count === 2000)", "op": "truthy", "label": "recipe: rain particles present" },
    { "do": "eval", "js": "window.__GF.cheat.goTo('npc:ada')" }, { "do": "step", "frames": 6 },
    { "do": "press", "action": "interact" }, { "do": "step", "frames": 120 },
    { "do": "expect", "path": "state", "op": "==", "value": "dialogue", "label": "recipe: runtime dialogue opens" },
    { "do": "press", "action": "choice1" }, { "do": "step", "frames": 120 }, { "do": "press", "action": "interact" }, { "do": "step", "frames": 30 },
    { "do": "expect", "path": "quests.lost_cat", "op": "==", "value": "active", "label": "recipe: dialogue starts runtime quest" },
    { "do": "eval", "js": "window.__GF.game.quests.report('custom', 'cat')" }, { "do": "step", "frames": 5 },
    { "do": "expect", "path": "quests.lost_cat", "op": "==", "value": "complete", "label": "recipe: custom objective completes quest" },
    { "do": "screenshot", "name": "lab" }
  ]
}
