{
  "name": "Neon Circuit",
  "serveRoot": "../..",
  "quality": "low",
  "steps": [
    { "do": "step", "frames": 30 },
    { "do": "expect", "path": "state", "op": "==", "value": "menu", "label": "title menu on boot" },
    { "do": "screenshot", "name": "01-title" },
    { "do": "call", "fn": "startGame" },
    { "do": "step", "frames": 30 },
    { "do": "expect", "path": "race.countdown", "op": ">", "value": 0, "label": "race starts with a countdown" },
    { "do": "hold", "action": "accelerate" }, { "do": "step", "frames": 120 },
    { "do": "expect", "path": "car.kmh", "op": "<", "value": 3, "label": "car is held during countdown" },
    { "do": "step", "frames": 120 },
    { "do": "expect", "path": "car.kmh", "op": ">", "value": 40, "label": "throttle accelerates the car after GO" },
    { "do": "expect", "path": "car.grounded", "op": "truthy", "label": "suspension keeps wheels on the road" },
    { "do": "canvas", "label": "driving frame renders" },
    { "do": "screenshot", "name": "02-driving" },
    { "do": "expect", "path": "trafficMoving", "op": ">=", "value": 3, "label": "AI traffic drives along lanes" },
    { "do": "hold", "action": "steerLeft" }, { "do": "step", "frames": 30 },
    { "do": "expect", "js": "window.__GF.state().car.yaw", "op": ">", "value": 0.15, "label": "steering left turns the car (yaw increases)" },
    { "do": "release", "action": "steerLeft" },
    { "do": "hold", "action": "handbrake" }, { "do": "hold", "action": "steerRight" }, { "do": "step", "frames": 40 },
    { "do": "release", "action": "handbrake" }, { "do": "release", "action": "steerRight" }, { "do": "release", "action": "accelerate" },
    { "do": "step", "frames": 60 },
    { "do": "expect", "path": "car.kmh", "op": ">=", "value": 0, "label": "handbrake drift sequence completes" },
    { "do": "eval", "js": "window.__GF.cheat.teleport(-31.5, -150, 0)" },
    { "do": "hold", "action": "accelerate" }, { "do": "step", "frames": 150 }, { "do": "release", "action": "accelerate" },
    { "do": "expect", "path": "car.kmh", "op": ">", "value": 60, "label": "car reaches speed on a straight" },
    { "do": "hold", "action": "brake" }, { "do": "step", "frames": 90 }, { "do": "release", "action": "brake" },
    { "do": "expect", "path": "car.kmh", "op": "<", "value": 15, "label": "brakes stop the car" },
    { "do": "eval", "js": "window.__GF.cheat.teleport(0, 0, 0)" },
    { "do": "eval", "js": "window.__GF.cheat.aimAt(28, 28)" },
    { "do": "hold", "action": "accelerate" }, { "do": "step", "frames": 240 }, { "do": "release", "action": "accelerate" },
    { "do": "expect", "js": "Math.hypot(window.__GF.state().car.x, window.__GF.state().car.z) < 34", "op": "truthy", "label": "buildings block the car (collision)" },
    { "do": "expect", "path": "car.damage", "op": ">", "value": 0, "label": "hard impacts damage the car" },
    { "do": "step", "frames": 30 },
    { "do": "eval", "js": "window.__GF.cheat.toNextGate()" }, { "do": "hold", "action": "accelerate" }, { "do": "step", "frames": 90 }, { "do": "release", "action": "accelerate" },
    { "do": "expect", "path": "race.nextGate", "op": ">=", "value": 1, "label": "driving through a gate scores a checkpoint" },
    { "do": "eval", "js": "for (let i = 0; i < 40 && !window.__GF.state().race.finished; i++) { window.__GF.cheat.toNextGate(); window.__GF.hold('accelerate'); window.__GF.step(70); }" },
    { "do": "release", "action": "accelerate" },
    { "do": "expect", "path": "race.finished", "op": "truthy", "label": "completing all checkpoints finishes the race" },
    { "do": "step", "frames": 120 },
    { "do": "expect", "js": "!!document.querySelector('#gf-retry')", "op": "truthy", "label": "results screen shows" },
    { "do": "screenshot", "name": "03-finish" }
  ]
}
