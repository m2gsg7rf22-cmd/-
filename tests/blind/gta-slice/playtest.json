{ "name": "Borrowed Shine (GTA-like blind-test slice)", "serveRoot": "../../..", "quality": "low", "loadTimeout": 300000, "steps": [
 { "do": "step", "frames": 30 },
 { "do": "expect", "path": "state", "op": "==", "value": "menu", "label": "title menu on boot" },
 { "do": "screenshot", "name": "01-title" },
 { "do": "call", "fn": "startGame" }, { "do": "step", "frames": 60 },
 { "do": "expect", "path": "state", "op": "==", "value": "playing", "label": "game starts" },
 { "do": "expect", "path": "player.grounded", "op": "truthy", "label": "player grounded on the sidewalk at spawn" },
 { "do": "expect", "path": "traffic", "op": ">=", "value": 4, "label": "traffic cars drive the streets" },
 { "do": "expect", "path": "crowd.agents", "op": ">=", "value": 30, "label": "30+ pedestrians with daily schedules" },
 { "do": "expect", "path": "crowd.templates", "op": ">=", "value": 1, "label": "realistic pedestrian templates built" },
 { "do": "canvas", "label": "street frame renders" },
 { "do": "screenshot", "name": "02-street" },

 { "do": "eval", "js": "window.__p0 = { ...window.__GF.state().player }" },
 { "do": "hold", "action": "moveForward" }, { "do": "step", "frames": 60 }, { "do": "release", "action": "moveForward" },
 { "do": "expect", "js": "(() => { const p = window.__GF.state().player, q = window.__p0; return Math.hypot(p.x - q.x, p.z - q.z) > 2.5; })()", "op": "truthy", "label": "W walks the player (third-person on foot)" },
 { "do": "step", "frames": 300 },
 { "do": "expect", "js": "window.__GF.crowd.peds.some((p) => p.agent.state === 'travel' || p.speed > 0.3)", "op": "truthy", "label": "pedestrians walk between schedule places" },

 { "do": "eval", "js": "window.__GF.cheat.nearNpc('lu')" }, { "do": "step", "frames": 10 },
 { "do": "press", "action": "interact", "frames": 2 }, { "do": "step", "frames": 20 },
 { "do": "expect", "path": "state", "op": "==", "value": "dialogue", "label": "E talks to Lu (dialogue opens)" },
 { "do": "press", "action": "interact", "frames": 2, "every": 15, "repeat": 4 }, { "do": "step", "frames": 60 },
 { "do": "expect", "path": "dialogue", "op": "==", "value": "lu_offer__pitch", "label": "dialogue advances to the job pitch (choices)" },
 { "do": "screenshot", "name": "03-dialogue" },
 { "do": "press", "action": "choice1", "frames": 2 }, { "do": "step", "frames": 20 },
 { "do": "press", "action": "interact", "frames": 2, "every": 15, "repeat": 3 }, { "do": "step", "frames": 30 },
 { "do": "expect", "path": "quests.borrowed_shine", "op": "==", "value": "active", "label": "mission 'Borrowed Shine' starts from the story dialogue" },
 { "do": "expect", "path": "state", "op": "==", "value": "playing", "label": "dialogue closes" },

 { "do": "eval", "js": "window.__GF.cheat.nearCoupe()" }, { "do": "step", "frames": 20 },
 { "do": "screenshot", "name": "04-coupe" },
 { "do": "expect", "path": "wanted.level", "op": "==", "value": 0, "label": "no wanted level before a crime" },
 { "do": "press", "action": "enterCar", "frames": 2 }, { "do": "step", "frames": 10 },
 { "do": "expect", "path": "driving", "op": "==", "value": "gold coupe", "label": "F enters (steals) the parked gold coupe" },
 { "do": "expect", "path": "mission.stolenCoupe", "op": "truthy", "label": "objective 'Steal the gold coupe' reported" },
 { "do": "expect", "path": "wanted.level", "op": ">=", "value": 1, "label": "car theft raises the wanted level" },
 { "do": "hold", "action": "accelerate" }, { "do": "step", "frames": 90 }, { "do": "release", "action": "accelerate" },
 { "do": "expect", "path": "car.kmh", "op": ">", "value": 40, "label": "the stolen car accelerates (W/throttle)" },
 { "do": "expect", "path": "car.z", "op": ">", "value": 40, "label": "the car drives down the street" },
 { "do": "screenshot", "name": "05-driving" },
 { "do": "hold", "action": "brake" }, { "do": "step", "frames": 55 }, { "do": "release", "action": "brake" },
 { "do": "expect", "js": "Math.abs(window.__GF.state().car.kmh)", "op": "<", "value": 15, "label": "brake slows the car to a crawl (< 15 km/h)" },
 { "do": "press", "action": "enterCar", "frames": 2 }, { "do": "step", "frames": 10 },
 { "do": "expect", "path": "driving", "op": "==", "value": null, "label": "F exits the car on foot" },

 { "do": "press", "action": "weapon2", "frames": 2 }, { "do": "step", "frames": 40 },
 { "do": "expect", "path": "shooter.weapon", "op": "==", "value": "rifle", "label": "switch to the rifle" },
 { "do": "eval", "js": "window.__GF.cheat.god()" },
 { "do": "hold", "action": "aim" }, { "do": "step", "frames": 30 },
 { "do": "expect", "path": "shooter.aiming", "op": "truthy", "label": "right mouse aims over the shoulder" },
 { "do": "screenshot", "name": "06-aim-rifle" },
 { "do": "press", "action": "fire", "frames": 2, "every": 8, "repeat": 6 }, { "do": "step", "frames": 10 },
 { "do": "release", "action": "aim" },
 { "do": "expect", "path": "shooter.shots", "op": ">=", "value": 3, "label": "rifle fires" },
 { "do": "expect", "js": "window.__GF.state().shooter.ammo < 30", "op": "truthy", "label": "ammo decreases" },
 { "do": "expect", "path": "wanted.level", "op": ">=", "value": 2, "label": "gunfire raises the wanted level further" },
 { "do": "expect", "js": "window.__GF.state().crimes.some((c) => c.crime === 'shooting')", "op": "truthy", "label": "shooting registered as a crime" },
 { "do": "step", "frames": 150 },
 { "do": "expect", "path": "policeOnFoot", "op": ">=", "value": 2, "label": "police officers spawn and pursue" },
 { "do": "expect", "js": "window.__GF.wanted.units.some((u) => u.goal)", "op": "truthy", "label": "officers have pursuit goals" },
 { "do": "expect", "js": "window.__GF.state().cruiser !== null", "op": "truthy", "label": "a police cruiser joins at level 2" },
 { "do": "expect", "js": "window.__GF.crowd.peds.some((p) => p.agent.state === 'flee' || p.agent.state === 'cower' || p.agent.state === 'watch') || window.__GF.state().crimes.every((c) => c.witnesses === 0)", "op": "truthy", "label": "nearby pedestrians react to the crime" },
 { "do": "step", "frames": 150 },
 { "do": "expect", "js": "(() => { const c = window.__GF.state().cruiser; return c && c.minDist < 30; })()", "op": "truthy", "label": "the cruiser drives toward the player" },
 { "do": "screenshot", "name": "07-pursuit" },

 { "do": "eval", "js": "window.__GF.cheat.nearCoupe()" }, { "do": "step", "frames": 2 },
 { "do": "press", "action": "enterCar", "frames": 2 }, { "do": "step", "frames": 10 },
 { "do": "expect", "path": "driving", "op": "==", "value": "gold coupe", "label": "back in the coupe" },
 { "do": "eval", "js": "window.__GF.cheat.carTo(-128, 128, 0)" }, { "do": "step", "frames": 120 },
 { "do": "expect", "path": "wanted.state", "op": "==", "value": "search", "label": "out of sight: police switch to search" },
 { "do": "step", "frames": 3600 },
 { "do": "expect", "path": "wanted.level", "op": "==", "value": 0, "label": "wanted level decays to zero after hiding" },
 { "do": "expect", "path": "policeOnFoot", "op": "==", "value": 0, "label": "pursuers despawn when clear" },
 { "do": "expect", "path": "mission.heatLost", "op": "truthy", "label": "objective 'Lose the police' reported" },

 { "do": "eval", "js": "window.__GF.cheat.carTo(84, 74.5, Math.PI / 2)" }, { "do": "step", "frames": 30 },
 { "do": "hold", "action": "accelerate" }, { "do": "step", "frames": 50 }, { "do": "release", "action": "accelerate" },
 { "do": "hold", "action": "brake" }, { "do": "step", "frames": 90 }, { "do": "release", "action": "brake" },
 { "do": "expect", "path": "mission.reachedHalfmoon", "op": "truthy", "label": "driving the coupe to Halfmoon completes the reach objective" },
 { "do": "screenshot", "name": "08-halfmoon" },
 { "do": "eval", "js": "window.__GF.cheat.nearNpc('ruiz')" }, { "do": "step", "frames": 10 },
 { "do": "press", "action": "interact", "frames": 2 }, { "do": "step", "frames": 20 },
 { "do": "press", "action": "interact", "frames": 2, "every": 15, "repeat": 4 }, { "do": "step", "frames": 40 },
 { "do": "expect", "path": "dialogue", "op": "==", "value": "ruiz_drop__choose", "label": "Ruiz offers the branch choice" },
 { "do": "screenshot", "name": "09-branch" },
 { "do": "press", "action": "choice2", "frames": 2 }, { "do": "step", "frames": 20 },
 { "do": "press", "action": "interact", "frames": 2, "every": 15, "repeat": 3 }, { "do": "step", "frames": 30 },
 { "do": "expect", "path": "quests.borrowed_shine", "op": "==", "value": "complete", "label": "branch chosen (squeeze Lu): mission 1 complete" },
 { "do": "expect", "path": "quests.payday", "op": "==", "value": "active", "label": "foldback mission 'Payday' starts automatically" },

 { "do": "eval", "js": "window.__GF.cheat.nearNpc('lu')" }, { "do": "step", "frames": 10 },
 { "do": "press", "action": "interact", "frames": 2 }, { "do": "step", "frames": 20 },
 { "do": "press", "action": "interact", "frames": 2, "every": 15, "repeat": 2 }, { "do": "step", "frames": 40 },
 { "do": "expect", "path": "dialogue", "op": "==", "value": "lu_payday__paid", "label": "Lu remembers the branch (squeezed_lu variant)" },
 { "do": "press", "action": "choice1", "frames": 2 }, { "do": "step", "frames": 20 },
 { "do": "press", "action": "interact", "frames": 2, "every": 15, "repeat": 3 }, { "do": "step", "frames": 60 },
 { "do": "expect", "path": "quests.payday", "op": "==", "value": "complete", "label": "mission 'Payday' completes" },
 { "do": "expect", "path": "goal.done", "op": "truthy", "label": "story ending reached (goal done)" },
 { "do": "screenshot", "name": "10-ending" },
 { "do": "expect", "js": "(() => { window.__GF.render(); const m = window.__GF.metrics(); return m.calls < 900 && m.triangles < 2500000; })()", "op": "truthy", "label": "frame within open-world budget (< 900 draw calls, < 2.5 M triangles)" }
]}
