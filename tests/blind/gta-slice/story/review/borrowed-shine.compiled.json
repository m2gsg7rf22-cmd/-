  "world": {
    "setting": "Port Solana, a hot harbour city of palm-lined avenues; this slice is Cobalt Row, a dense mixed district of shops and towers.",
    "facts": [
      "Cobalt Row runs on cash, scooters and favours owed to Lu Anwen.",
      "Councilman Pryce parks his gold coupe on the street because nobody would dare touch it.",
      "The Halfmoon body shop repaints anything in forty minutes, no questions.",
      "Port Solana police answer gunfire fast and car theft faster on Cobalt Row."
    ],
    "locations": [
      {
        "id": "taqueria",
        "name": "Lu's Corner Taqueria",
        "desc": "A street-corner counter where Lu holds court.",
        "hooks": [
          "A jar of IOU slips by the register",
          "Two plastic chairs, one always kept for Lu",
          "Scooter keys hanging on nails behind the counter"
        ]
      },
      {
        "id": "coupe_spot",
        "name": "Pryce's Curb",
        "desc": "A no-parking curb where the gold coupe sits untouched.",
        "hooks": [
          "A gold coupe parked across two spaces",
          "Unpaid parking tickets tucked under the wiper",
          "Pedestrians giving the car a wide berth"
        ]
      },
      {
        "id": "halfmoon",
        "name": "Halfmoon Body Shop",
        "desc": "A paint shop at the edge of the district.",
        "hooks": [
          "Fresh primer drips on the kerb",
          "A licence-plate stack sorted by colour",
          "Ruiz's radio playing old ballads"
        ]
      }
    ]
  }
