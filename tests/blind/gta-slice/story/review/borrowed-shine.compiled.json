          },
          {
            "type": "pants",
            "color": 2763306
          },
          {
            "type": "shoes",
            "color": 3811872
          }
        ]
      },
      "dialogue": {
        "start": [
          {
            "if": [
              "quest:payday==active"
            ],
            "node": "lu_payday__start"
          },
          {
            "if": [
              "quest:borrowed_shine==active"
            ],
            "node": "lu_wait__start"
          },
          {
            "if": [
              "!quest:borrowed_shine"
            ],
            "node": "lu_offer__start"
          },
          {
            "node": "lu__idle"
          }
        ],
        "nodes": {
          "lu_payday__start": {
            "if": "squeezed_lu",
            "else": "lu_payday__partner",
            "next": "lu_payday__paid",
            "do": [
              "set seen:lu_payday"
            ]
          },
          "lu_payday__partner": {
            "choices": [
              {
                "text": "No more work, Lu.",
                "next": "lu_payday__out",
                "do": [
                  "set settled"
                ]
              },
              {
                "text": "Partner gets a cut.",
                "next": "lu_payday__in",
                "if": "kept_word",
                "do": [
                  "set settled"
                ]
              }
            ],
            "speaker": "Lu",
            "text": "Ruiz says you gave it away. Stupid. Loyal. Sit down, partner, there is more work."
          },
          "lu_payday__paid": {
            "choices": [
              {
                "text": "Worth it.",
                "next": "lu_payday__out",
                "do": [
                  "set settled"
                ]
              },
              {
                "text": "We were never even.",
                "next": "lu_payday__out",
                "do": [
                  "set settled"
                ]
              }
            ],
            "speaker": "Lu",
            "text": "Two grand, Dez. You learned to count. Take it, and find another street."
          },
          "lu_payday__in": {
            "speaker": "Lu",
            "text": "Half a cut. Eat something first.",
            "next": "end"
          },
          "lu_payday__out": {
            "speaker": "Lu",
            "text": "The street remembers. So do I.",
            "next": "end"
          },
          "lu_wait__start": {
            "speaker": "Lu",
            "text": "The coupe will not drive itself to Ruiz. Go.",
            "next": "end",
            "do": [
              "set seen:lu_wait"
            ]
          },
          "lu_offer__start": {
            "speaker": "Lu",
            "text": "Dez. Sit. You look like a man who skipped breakfast and his conscience.",
            "next": "lu_offer__reply",
            "do": [
              "set seen:lu_offer"
            ]
          },
          "lu_offer__reply": {
            "speaker": "Dez",
            "text": "I deliver tacos now, Lu. Legal tacos.",
            "next": "lu_offer__pitch"
          },
          "lu_offer__pitch": {
            "choices": [
              {
                "text": "Even means even.",
                "next": "lu_offer__accept",
                "do": [
                  "start borrowed_shine"
                ]
              },
              {
                "text": "In daylight? Seriously?",
                "next": "lu_offer__daylight"
              }
            ],
            "speaker": "Lu",
            "text": "Pryce parks his gold coupe on my street. Bring it to Ruiz at Halfmoon. Then we are even."
          },
          "lu_offer__daylight": {
            "choices": [
              {
                "text": "Fine. Last favour.",
                "next": "lu_offer__accept",
                "do": [
                  "start borrowed_shine"
                ]
              }
            ],
            "speaker": "Lu",
            "text": "Daylight is when people stare. Let them. Pryce needs the embarrassment."
          },
          "lu_offer__accept": {
            "speaker": "Lu",
            "text": "Good boy. The coupe is two blocks over. Mind the police, they love that car.",
            "next": "end"
          },
          "lu__idle": {
            "speaker": "Lu Anwen",
            "text": "Eat first, sin after.",
            "next": "end"
          }
        }
      }
    },
    {
      "id": "ruiz",
