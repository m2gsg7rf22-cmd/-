            "node": "ruiz_early__start"
          },
          {
            "node": "ruiz__idle"
          }
        ],
        "nodes": {
          "ruiz_drop__start": {
            "speaker": "Ruiz",
            "text": "Gold. Of course it is gold. Lu said you would bring it for free.",
            "next": "ruiz_drop__choose",
            "do": [
              "set seen:ruiz_drop"
            ]
          },
          "ruiz_drop__choose": {
            "choices": [
              {
                "text": "Keys. We're even now.",
                "next": "ruiz_drop__word",
                "do": [
                  "set kept_word",
                  "set coupe_handed"
                ]
              },
              {
                "text": "Free? Tell Lu it costs two grand.",
                "next": "ruiz_drop__squeeze",
                "do": [
                  "set squeezed_lu",
                  "set coupe_handed"
                ]
              }
            ],
            "speaker": "Dez",
            "text": "Did she."
          },
          "ruiz_drop__word": {
            "speaker": "Ruiz",
            "text": "A man of his word. Rare on this street. Go tell her.",
            "next": "end"
          },
          "ruiz_drop__squeeze": {
            "speaker": "Ruiz",
            "text": "She will pay. She will also remember. Go tell her.",
            "next": "end"
          },
          "ruiz_early__start": {
            "speaker": "Ruiz",
            "text": "No car, no conversation. Forty minutes starts when you park.",
            "next": "end",
            "do": [
              "set seen:ruiz_early"
            ]
          },
          "ruiz__idle": {
            "speaker": "Tomas Ruiz",
            "text": "Forty minutes. Fifty if you talk.",
            "next": "end"
          }
        }
      }
    }
  ],
