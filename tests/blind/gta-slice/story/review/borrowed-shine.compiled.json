{
  "format": "gameforge.story/1",
  "id": "borrowed-shine",
  "title": "Borrowed Shine",
  "premise": "A broke courier who swore off crime must steal a councilman's gold coupe for the fixer who saved his life, and decide whether a favour repaid is worth more than a fair price.",
  "logline": "One car, one favour, one city that never forgets who drove it.",
  "themes": [
    "Is a debt of gratitude ever paid in full?",
    "Who owns a favour once it is cashed?"
  ],
  "tone": "Sun-bleached street crime; quick humour; consequences that land in daylight.",
  "characters": [
    {
      "id": "dez",
      "name": "Dez Varga",
      "role": "protagonist",
      "main": true,
      "want": "Pay back Lu and walk away clean.",
      "need": "Accept that he chooses who he owes.",
      "flaw": "Says yes to anyone who was kind to him once.",
      "arc": "From a courier who cannot refuse Lu to a man who names his own price, or keeps his word on purpose.",
      "voice": "Short sentences, delivery-route slang, jokes when nervous."
    },
    {
      "id": "lu",
      "name": "Lu Anwen",
      "role": "fixer",
      "main": true,
      "want": "Embarrass Councilman Pryce before the election.",
      "need": "See that her favours make people small.",
      "flaw": "Treats kindness as an investment.",
      "arc": "From a patron who collects people to someone who either earns Dez's loyalty or loses it.",
      "voice": "Warm, amused, food metaphors, never says thank you."
    },
    {
      "id": "ruiz",
      "name": "Tomas Ruiz",
      "role": "mechanic",
      "main": false,
      "want": "Retire to his brother's farm with clean hands.",
      "need": "",
      "flaw": "",
      "arc": "",
      "voice": "Grumbling, slow, talks to cars like old dogs."
    }
  ],
  "npcs": [
    {
      "id": "lu",
      "name": "Lu Anwen",
      "role": "fixer",
      "at": "taqueria",
      "look": {
        "archetype": "civilian",
        "seed": 12,
        "sex": 0,
        "age": 52,
        "heightCm": 164,
        "hair": "bun",
        "hairColor": 2827554,
