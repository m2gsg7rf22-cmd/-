{
  "name": "Shooting Range (shooter kit)",
  "serveRoot": "../../..",
  "quality": "low",
  "perfSampleMs": 1500,
  "steps": [
    { "do": "step", "frames": 30 },
    { "do": "expect", "path": "state", "op": "==", "value": "playing", "label": "scene boots into play" },
    { "do": "expect", "path": "weapon", "op": "==", "value": "rifle", "label": "rifle equipped" },
    { "do": "expect", "path": "hud.ammo.mag", "op": "==", "value": 30, "label": "ammo HUD shows a full magazine" },
    { "do": "screenshot", "name": "01-range" },

    { "do": "eval", "js": "window.__GF.cheat.aimAt(0)" },
    { "do": "hold", "action": "aim" }, { "do": "step", "frames": 20 },
    { "do": "expect", "path": "aiming", "op": "truthy", "label": "Mouse2 (aim) enters aim mode" },
    { "do": "expect", "path": "fov", "op": "<", "value": 50, "label": "aim mode zooms the camera (FOV)" },
    { "do": "eval", "js": "window.__GF.cheat.aimAt(0)" },
    { "do": "hold", "action": "fire" }, { "do": "step", "frames": 8 },
    { "do": "screenshot", "name": "02-aim-fire" },
    { "do": "step", "frames": 10 }, { "do": "release", "action": "fire" }, { "do": "step", "frames": 25 },
    { "do": "expect", "js": "window.__GF.state().targetHp[0]", "op": "<", "value": 100, "label": "hitting the target damages it" },
    { "do": "eval", "js": "for (let i = 0; i < 4 && window.__GF.state().targetKills === 0; i++) { window.__GF.cheat.aimAt(0); window.__GF.hold('fire'); window.__GF.step(15); window.__GF.release('fire'); window.__GF.step(20); }" },
    { "do": "expect", "path": "ammo", "op": "<", "value": 30, "label": "firing reduces ammo" },
    { "do": "expect", "path": "shots", "op": ">=", "value": 5, "label": "automatic fire keeps firing while held" },
    { "do": "expect", "path": "targetHits", "op": ">", "value": 0, "label": "hitscan hits the target" },
    { "do": "expect", "path": "targetKills", "op": ">=", "value": 1, "label": "controlled bursts drop the target (kill event)" },
    { "do": "expect", "path": "hud.reticleHits", "op": ">", "value": 0, "label": "crosshair shows hit markers" },
    { "do": "expect", "js": "window.__GF.state().hud.ammo.mag === window.__GF.state().ammo", "op": "truthy", "label": "ammo HUD tracks the magazine" },

    { "do": "press", "action": "reload", "frames": 2 }, { "do": "step", "frames": 30 },
    { "do": "expect", "path": "reloading", "op": "truthy", "label": "reload key starts a reload" },
    { "do": "step", "frames": 140 },
    { "do": "expect", "path": "ammo", "op": "==", "value": 30, "label": "reload restores the magazine" },
    { "do": "expect", "path": "reserve", "op": "<", "value": 120, "label": "reload consumes reserve ammo" },

    { "do": "eval", "js": "window.__GF.cheat.aimAt(2, 'head')" },
    { "do": "press", "action": "fire", "frames": 2 }, { "do": "step", "frames": 10 },
    { "do": "expect", "path": "headshots", "op": ">=", "value": 1, "label": "head hitbox registers headshots" },
    { "do": "release", "action": "aim" }, { "do": "step", "frames": 20 },

    { "do": "press", "action": "weapon2", "frames": 2 }, { "do": "step", "frames": 30 },
    { "do": "expect", "path": "weapon", "op": "==", "value": "pistol", "label": "number keys switch weapons" },
    { "do": "press", "action": "fire", "frames": 6 }, { "do": "step", "frames": 20 },
    { "do": "expect", "path": "ammo", "op": "==", "value": 11, "label": "semi-auto fires one round per press" },
    { "do": "press", "action": "weapon3", "frames": 2 }, { "do": "step", "frames": 40 },
    { "do": "press", "action": "fire", "frames": 2 }, { "do": "step", "frames": 10 },
    { "do": "expect", "path": "weapon", "op": "==", "value": "shotgun", "label": "shotgun equipped" },
    { "do": "expect", "path": "ammo", "op": "==", "value": 5, "label": "shotgun fires a pellet shell" },
    { "do": "press", "action": "weapon1", "frames": 2 }, { "do": "step", "frames": 40 },

    { "do": "press", "action": "camera", "frames": 2 }, { "do": "step", "frames": 20 },
    { "do": "expect", "path": "view", "op": "==", "value": "first", "label": "camera key switches to first-person" },
    { "do": "canvas", "label": "first-person frame renders", "minColors": 30 },
    { "do": "screenshot", "name": "03-first-person" },
    { "do": "hold", "action": "aim" }, { "do": "step", "frames": 20 },
    { "do": "screenshot", "name": "03b-first-person-ads" },
    { "do": "release", "action": "aim" },
    { "do": "press", "action": "camera", "frames": 2 }, { "do": "step", "frames": 20 },
    { "do": "expect", "path": "view", "op": "==", "value": "third", "label": "and back to third-person" },

    { "do": "eval", "js": "window.__GF.cheat.teleport(-6, 1.4, 0)" }, { "do": "step", "frames": 10 },
    { "do": "press", "action": "cover", "frames": 2 }, { "do": "step", "frames": 40 },
    { "do": "expect", "path": "inCover", "op": "truthy", "label": "cover key snaps to nearby cover" },
    { "do": "expect", "path": "coverLow", "op": "==", "value": true, "label": "low wall detected as low cover" },
    { "do": "expect", "path": "player.z", "op": ">", "value": 2.2, "label": "player slides onto the wall" },
    { "do": "expect", "path": "crouching", "op": "truthy", "label": "player crouches behind low cover" },
    { "do": "hold", "action": "moveRight" }, { "do": "step", "frames": 120 }, { "do": "release", "action": "moveRight" },
    { "do": "expect", "path": "inCover", "op": "truthy", "label": "moving sideways slides along cover" },
    { "do": "expect", "path": "player.x", "op": "<", "value": -4.5, "label": "cover movement stops at the edge" },
    { "do": "screenshot", "name": "04-low-cover" },
    { "do": "hold", "action": "aim" }, { "do": "step", "frames": 20 },
    { "do": "expect", "path": "crouching", "op": "falsy", "label": "aiming from low cover stands up to shoot over it" },
    { "do": "release", "action": "aim" }, { "do": "step", "frames": 10 },
    { "do": "press", "action": "cover", "frames": 2 }, { "do": "step", "frames": 10 },
    { "do": "expect", "path": "inCover", "op": "falsy", "label": "cover key leaves cover" },

    { "do": "eval", "js": "window.__GF.cheat.teleport(6.2, 1.2, 0)" }, { "do": "step", "frames": 10 },
    { "do": "press", "action": "cover", "frames": 2 }, { "do": "step", "frames": 40 },
    { "do": "expect", "path": "coverLow", "op": "==", "value": false, "label": "pillar detected as high cover" },
    { "do": "hold", "action": "aim" }, { "do": "step", "frames": 40 },
    { "do": "expect", "path": "peeking", "op": "truthy", "label": "aiming at a high-cover edge peeks out" },
    { "do": "screenshot", "name": "05-high-cover-peek" },
    { "do": "release", "action": "aim" }, { "do": "step", "frames": 30 },
    { "do": "press", "action": "cover", "frames": 2 }, { "do": "step", "frames": 10 },

    { "do": "eval", "js": "window.__GF.cheat.teleport(0, 4, 0)" },
    { "do": "eval", "js": "window.__GF.cheat.activate()" },
    { "do": "step", "frames": 480 },
    { "do": "expect", "path": "enemyShots", "op": ">", "value": 0, "label": "AI shoots back" },
    { "do": "expect", "path": "hitsOnPlayer", "op": ">", "value": 0, "label": "AI bullets hit the player" },
    { "do": "expect", "path": "player.damageTaken", "op": ">", "value": 0, "label": "player takes damage from AI" },
    { "do": "expect", "js": "['takeCover','cover','peek'].every(s => window.__GF.state().enemyStates.includes(s))", "op": "truthy", "label": "AI takes cover and peek-shoots" },
    { "do": "expect", "js": "window.__GF.state().enemies.some(e => e.inCover)", "op": "truthy", "label": "AI is using cover" },
    { "do": "eval", "js": "window.__GF.cheat.teleport(2, 21)" },
    { "do": "eval", "js": "window.__GF.cheat.aimAtEnemy(0)" },
    { "do": "screenshot", "name": "06-ai-firefight" },
    { "do": "eval", "js": "window.__GF.cheat.killEnemy(0)" }, { "do": "step", "frames": 30 },
    { "do": "expect", "js": "window.__GF.state().enemies[0].state", "op": "==", "value": "dead", "label": "AI stops when killed" },
    { "do": "expect", "path": "player.hp", "op": ">", "value": 0, "label": "player alive" }
  ]
}
