{
  "name": "Navmesh scene",
  "serveRoot": "../../..",
  "quality": "medium",
  "steps": [
    { "do": "step", "frames": 30 },
    { "do": "expect", "path": "state", "op": "==", "value": "playing", "label": "scene boots into play" },
    { "do": "expect", "path": "nav.polys", "op": ">", "value": 40, "label": "navmesh built (convex polygons)" },
    { "do": "expect", "path": "nav.regions", "op": "==", "value": 1, "label": "seeds keep one connected region (roofs pruned)" },
    { "do": "expect", "js": "(p => p && Math.abs(p.points[p.n - 1][1] - 3) < 0.05)(window.__GF.scene.path([-14, 0, 0], [0, 3, 6]))", "op": "truthy", "label": "path climbs the stairs onto the bridge deck (y = 3)" },
    { "do": "expect", "js": "(p => p && p.points.every(q => q[1] < 0.5))(window.__GF.scene.path([-2, 0, 12], [2, 0, 0]))", "op": "truthy", "label": "ground path passes under the bridge (stays on the ground level)" },
    { "do": "expect", "js": "(p => p && Math.abs(p.points[p.n - 1][1] - 1.5) < 0.05)(window.__GF.scene.path([10, 0, 0], [22, 1.5, 0]))", "op": "truthy", "label": "ramp leads onto the 1.5 m platform" },
    { "do": "canvas", "label": "scene renders" },
    { "do": "screenshot", "name": "01-overview" },

    { "do": "eval", "js": "window.__GF.scene.run(45)" },
    { "do": "expect", "path": "agents.arrivals", "op": ">=", "value": 20, "label": "agents reach their destinations (20+ arrivals in 45 s)" },
    { "do": "expect", "path": "agents.offMesh", "op": "==", "value": 0, "label": "agents never leave the walkable mesh" },
    { "do": "expect", "path": "agents.wallClips", "op": "==", "value": 0, "label": "agents never clip walls, pillars, crates or railings" },
    { "do": "expect", "path": "agents.minPair", "op": ">", "value": 0.45, "label": "local avoidance keeps agents apart (radius 0.35 each)" },
    { "do": "expect", "path": "agents.deckVisitors", "op": ">=", "value": 1, "label": "agents walk over the bridge" },
    { "do": "expect", "path": "agents.underBridge", "op": ">", "value": 0, "label": "agents walk under the bridge" },
    { "do": "expect", "path": "agents.platformVisitors", "op": ">=", "value": 1, "label": "agents walk up the ramp to the platform" },
    { "do": "expect", "path": "agents.courtyardVisitors", "op": ">=", "value": 1, "label": "agents enter the courtyard through the doorway" },
    { "do": "eval", "js": "window.__GF.scene.view('bridge')" },
    { "do": "step", "frames": 2 },
    { "do": "screenshot", "name": "02-bridge" },

    { "do": "eval", "js": "window.__before = window.__GF.scene.path([-8.5, 0, 6], [5, 0, 6]).length; window.__GF.scene.parkCar(); window.__GF.scene.view('overview')" },
    { "do": "expect", "path": "car", "op": "truthy", "label": "car parked under the bridge (dynamic obstacle)" },
    { "do": "expect", "js": "window.__GF.scene.pathAvoids([-8.5, 0, 6], [5, 0, 6], window.__GF.scene.carBox)", "op": "truthy", "label": "path reroutes around the parked car" },
    { "do": "expect", "js": "window.__GF.scene.path([-8.5, 0, 6], [5, 0, 6]).length > window.__before", "op": "truthy", "label": "rerouted path is longer than the free one" },
    { "do": "eval", "js": "window.__GF.scene.run(20)" },
    { "do": "expect", "path": "agents.carClips", "op": "==", "value": 0, "label": "agents re-plan and never walk through the car" },
    { "do": "expect", "path": "agents.offMesh", "op": "==", "value": 0, "label": "still no agent off the mesh" },
    { "do": "expect", "path": "agents.wallClips", "op": "==", "value": 0, "label": "still no wall clipping" },
    { "do": "screenshot", "name": "03-car-obstacle" },

    { "do": "eval", "js": "window.__GF.scene.closeDoor(); window.__GF.scene.view('door')" },
    { "do": "expect", "js": "window.__GF.scene.path([0, 0, -4], [0, 0, -14]) === null", "op": "truthy", "label": "closed door makes the courtyard unreachable (null path)" },
    { "do": "step", "frames": 30 },
    { "do": "screenshot", "name": "04-door-closed" },
    { "do": "eval", "js": "window.__GF.scene.openDoor()" },
    { "do": "expect", "js": "window.__GF.scene.path([0, 0, -4], [0, 0, -14]) !== null", "op": "truthy", "label": "opening the door restores the path" },
    { "do": "eval", "js": "window.__GF.scene.removeCar(); window.__GF.scene.view('ramp'); window.__GF.scene.run(5)" },
    { "do": "expect", "path": "agents.wallClips", "op": "==", "value": 0, "label": "no wall clipping over the whole run" },
    { "do": "screenshot", "name": "05-ramp" },
    { "do": "eval", "js": "window.__GF.scene.overlay(false); window.__GF.scene.view('overview')" },
    { "do": "step", "frames": 2 },
    { "do": "canvas", "label": "scene renders without the overlay" },
    { "do": "screenshot", "name": "06-no-overlay" }
  ]
}
