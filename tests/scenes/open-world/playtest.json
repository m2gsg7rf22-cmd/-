{
  "name": "Open World Systems (integration scene)",
  "serveRoot": "../../..",
  "quality": "low",
  "loadTimeout": 240000,
  "steps": [
    { "do": "step", "frames": 30 },
    { "do": "expect", "path": "state", "op": "==", "value": "playing", "label": "scene boots into play" },
    { "do": "expect", "path": "chunks.loaded", "op": ">=", "value": 4, "label": "chunks around the player are resident" },
    { "do": "expect", "js": "(() => { const c = window.__GF.state().chunks; return c.buildingsVisible > 0 && c.buildingsVisible < c.buildingsTotal; })()", "op": "truthy", "label": "only nearby buildings are streamed in" },
    { "do": "expect", "path": "crowd.agents", "op": ">=", "value": 30, "label": "30+ scheduled pedestrians" },
    { "do": "expect", "path": "crowd.templates", "op": ">=", "value": 1, "label": "realistic crowd templates built (crowd LOD)" },
    { "do": "eval", "js": "window.__GF.cheat.goBlock(3, 3); window.__GF.cheat.setHour(10)" }, { "do": "step", "frames": 60 },
    { "do": "expect", "path": "crowd.mid", "op": ">=", "value": 1, "label": "mid-range pedestrians use mannequins" },
    { "do": "expect", "js": "window.__GF.state().crowd.near <= 6", "op": "truthy", "label": "realistic tier capped at maxNear" },
    { "do": "canvas", "label": "city frame renders" },
    { "do": "screenshot", "name": "01-street" },
    { "do": "eval", "js": "window.__t0 = window.__GF.state().chunks" },
    { "do": "eval", "js": "window.__GF.cheat.goTo(-190, -190)" }, { "do": "step", "frames": 120 },
    { "do": "expect", "js": "window.__GF.state().chunks.loads > window.__t0.loads", "op": "truthy", "label": "moving across the city streams new chunks in" },
    { "do": "expect", "js": "window.__GF.state().chunks.unloads > window.__t0.unloads", "op": "truthy", "label": "chunks left behind are unloaded" },
    { "do": "expect", "path": "chunks.pending", "op": "==", "value": 0, "label": "streaming queue drains within budget" },
    { "do": "eval", "js": "window.__GF.cheat.goBlock(3, 3); window.__GF.cheat.setHour(3)" }, { "do": "step", "frames": 30 },
    { "do": "expect", "js": "(window.__GF.cheat.activities().sleep || 0) >= 22", "op": "truthy", "label": "time jump to 3 am: most pedestrians sleep" },
    { "do": "expect", "js": "window.__GF.state().crowd.visible <= 10", "op": "truthy", "label": "night streets are nearly empty" },
    { "do": "expect", "js": "window.__GF.cheat.scheduleConsistency() > 0.85", "op": "truthy", "label": "after the jump agents are at their schedule places" },
    { "do": "eval", "js": "window.__GF.cheat.setHour(12.6)" }, { "do": "step", "frames": 30 },
    { "do": "expect", "js": "(window.__GF.cheat.activities().eat || 0) >= 8", "op": "truthy", "label": "time jump to lunch: pedestrians go to eat" },
    { "do": "eval", "js": "window.__GF.cheat.setHour(10)" }, { "do": "step", "frames": 30 },
    { "do": "expect", "js": "(window.__GF.cheat.activities().work || 0) >= 8", "op": "truthy", "label": "time jump to 10 am: workers at work" },
    { "do": "expect", "js": "window.__GF.cheat.scheduleConsistency() > 0.85", "op": "truthy", "label": "schedule positions consistent at 10 am" },
    { "do": "step", "frames": 300 },
    { "do": "expect", "js": "window.__GF.crowd.peds.some((p) => p.agent.state === 'travel' || p.speed > 0.3)", "op": "truthy", "label": "pedestrians walk in real time" },
    { "do": "expect", "path": "wanted.level", "op": "==", "value": 0, "label": "no wanted level before a crime" },
    { "do": "expect", "js": "window.__GF.cheat.goNearPedestrian()", "op": "truthy", "label": "player walks up to a pedestrian" }, { "do": "step", "frames": 2 },
    { "do": "eval", "js": "window.__GF.cheat.crime('assault'); window.__GF.cheat.crime('shooting')" }, { "do": "step", "frames": 10 },
    { "do": "expect", "path": "wanted.level", "op": ">=", "value": 2, "label": "crimes raise the wanted level" },
    { "do": "expect", "js": "window.__GF.crowd.peds.some((p) => p.agent.state === 'flee')", "op": "truthy", "label": "nearby pedestrians flee the crime" },
    { "do": "step", "frames": 90 },
    { "do": "expect", "path": "police", "op": ">=", "value": 3, "label": "pursuers spawn for the level" },
    { "do": "expect", "js": "window.__GF.state().stars === window.__GF.state().wanted.level", "op": "truthy", "label": "HUD stars show the level" },
    { "do": "expect", "js": "window.__GF.wanted.units.some((u) => u.goal)", "op": "truthy", "label": "pursuers have pursuit goals" },
    { "do": "screenshot", "name": "02-pursuit" },
    { "do": "step", "frames": 600 },
    { "do": "expect", "js": "window.__GF.crowd.peds.every((p) => !p.agent.interruption)", "op": "truthy", "label": "pedestrians resume their schedules after the scare" },
    { "do": "eval", "js": "window.__GF.cheat.goTo(190, -190)" }, { "do": "step", "frames": 60 },
    { "do": "expect", "path": "wanted.state", "op": "==", "value": "search", "label": "breaking line of sight starts the search cooldown" },
    { "do": "step", "frames": 2400 },
    { "do": "expect", "path": "wanted.level", "op": "==", "value": 0, "label": "wanted level decays to zero after hiding" },
    { "do": "expect", "path": "police", "op": "==", "value": 0, "label": "pursuers despawn when clear" },
    { "do": "eval", "js": "window.__GF.cheat.goBlock(3, 3)" }, { "do": "step", "frames": 60 },
    { "do": "screenshot", "name": "03-calm" },
    { "do": "expect", "js": "(() => { window.__GF.render(); const m = window.__GF.metrics(); return m.calls < 900 && m.triangles < 2500000; })()", "op": "truthy", "label": "frame within budget (< 900 draw calls, < 2.5 M triangles)" }
  ]
}
