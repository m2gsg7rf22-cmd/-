{
  "name": "blockforge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "vite-node tests/bench.perf.ts",
    "qa:e2e": "node scripts/e2e.mjs",
    "qa:touch": "node scripts/touch.mjs",
    "qa:responsive": "node scripts/responsive.mjs",
    "qa:failures": "node scripts/failures.mjs",
    "qa:bughunt": "node scripts/bughunt.mjs",
    "qa:memory": "node scripts/memory.mjs",
    "qa:visual": "node scripts/visual.mjs",
    "qa:gamepad": "node scripts/gamepad.mjs",
    "build:single": "tsc --noEmit && vite build --mode single"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.180.0",
    "playwright": "^1.56.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.7"
  }
}
