{
  "name": "Lantern Isle",
  "serveRoot": "../..",
  "quality": "low",
  "steps": [
    { "do": "step", "frames": 30 },
    { "do": "expect", "path": "state", "op": "==", "value": "menu", "label": "title menu on boot" },
    { "do": "screenshot", "name": "01-title" },
    { "do": "call", "fn": "startGame" }, { "do": "step", "frames": 60 },
    { "do": "expect", "path": "state", "op": "==", "value": "playing", "label": "new game starts on the beach" },
    { "do": "expect", "path": "player.grounded", "op": "truthy", "label": "player stands on the island" },
    { "do": "canvas", "label": "island frame renders" },
    { "do": "screenshot", "name": "02-beach" },
    { "do": "hold", "action": "moveForward" }, { "do": "step", "frames": 60 }, { "do": "release", "action": "moveForward" },
    { "do": "expect", "js": "Math.abs(window.__GF.state().player.z - window.__GF.player.ctrl.lastGroundY) >= 0", "op": "truthy", "label": "player can walk" },
    { "do": "eval", "js": "window.__GF.cheat.goTo('npc:mira')" }, { "do": "step", "frames": 10 },
    { "do": "expect", "path": "focus", "op": "==", "value": "npc:mira", "label": "approaching an NPC shows a talk prompt" },
    { "do": "press", "action": "interact" }, { "do": "step", "frames": 90 },
    { "do": "expect", "path": "state", "op": "==", "value": "dialogue", "label": "E starts a conversation" },
    { "do": "expect", "path": "dialogue.speaker", "op": "==", "value": "Keeper Mira", "label": "dialogue shows the speaker" },
    { "do": "screenshot", "name": "03-dialogue" },
    { "do": "press", "action": "interact" }, { "do": "step", "frames": 90 },
    { "do": "press", "action": "interact" }, { "do": "step", "frames": 90 },
    { "do": "expect", "path": "dialogue.choices", "op": "==", "value": 3, "label": "branching choices are offered" },
    { "do": "press", "action": "choice2" }, { "do": "step", "frames": 90 },
    { "do": "press", "action": "interact" }, { "do": "step", "frames": 90 },
    { "do": "press", "action": "interact" }, { "do": "step", "frames": 90 },
    { "do": "expect", "path": "quests.crystals", "op": "==", "value": "active", "label": "dialogue choice starts the main quest" },
    { "do": "expect", "path": "inventory.lantern", "op": "==", "value": 1, "label": "dialogue action gives an item" },
    { "do": "expect", "path": "state", "op": "==", "value": "playing", "label": "conversation ends and control returns" },
    { "do": "eval", "js": "window.__GF.cheat.goTo('npc:bram')" }, { "do": "step", "frames": 5 }, { "do": "press", "action": "interact" }, { "do": "step", "frames": 90 },
    { "do": "press", "action": "interact" }, { "do": "step", "frames": 90 },
    { "do": "press", "action": "choice2" }, { "do": "step", "frames": 90 },
    { "do": "press", "action": "interact" }, { "do": "step", "frames": 90 },
    { "do": "expect", "path": "flags.bram_key", "op": "truthy", "label": "a second NPC branch sets story flags" },
    { "do": "expect", "path": "quests.chest", "op": "!=", "value": "missing", "label": "side quest is defined" },
    { "do": "eval", "js": "window.__GF.cheat.goTo('crystal:east')" }, { "do": "step", "frames": 5 }, { "do": "press", "action": "interact" }, { "do": "step", "frames": 30 },
    { "do": "expect", "path": "inventory.crystal", "op": "==", "value": 1, "label": "collecting a crystal adds it to the inventory" },
    { "do": "eval", "js": "window.__GF.cheat.goTo('crystal:south')" }, { "do": "step", "frames": 5 }, { "do": "press", "action": "interact" }, { "do": "step", "frames": 30 },
    { "do": "eval", "js": "window.__GF.cheat.goTo('chest')" }, { "do": "step", "frames": 5 }, { "do": "press", "action": "interact" }, { "do": "step", "frames": 60 },
    { "do": "expect", "path": "money", "op": "==", "value": 50, "label": "the key opens the ruin chest (item-gated interaction)" },
    { "do": "eval", "js": "window.__GF.cheat.goTo('crystal:ruins')" }, { "do": "step", "frames": 5 }, { "do": "press", "action": "interact" }, { "do": "step", "frames": 30 },
    { "do": "expect", "path": "quests.crystals", "op": "==", "value": "complete", "label": "three crystals complete the quest" },
    { "do": "expect", "path": "quests.light", "op": "==", "value": "active", "label": "quest chain unlocks the next quest" },
    { "do": "eval", "js": "window.__GF.cheat.save()" },
    { "do": "expect", "path": "hasSave", "op": "truthy", "label": "game state is saved" },
    { "do": "eval", "js": "window.__GF.cheat.goTo('npc:tobin')" }, { "do": "step", "frames": 5 },
    { "do": "eval", "js": "window.__GF.cheat.load()" }, { "do": "step", "frames": 5 },
    { "do": "expect", "path": "inventory.crystal", "op": "==", "value": 3, "label": "loading restores inventory and quests" },
    { "do": "eval", "js": "window.__GF.cheat.goTo('lighthouse')" }, { "do": "step", "frames": 5 },
    { "do": "expect", "path": "focus", "op": "==", "value": "lighthouse", "label": "lighthouse accepts the crystals" },
    { "do": "press", "action": "interact" }, { "do": "step", "frames": 30 },
    { "do": "expect", "path": "state", "op": "==", "value": "cutscene", "label": "relighting plays the ending cinematic" },
    { "do": "step", "frames": 300 },
    { "do": "screenshot", "name": "04-cinematic" },
    { "do": "step", "frames": 300 },
    { "do": "expect", "path": "lit", "op": "truthy", "label": "the lighthouse is lit" },
    { "do": "expect", "path": "quests.light", "op": "==", "value": "complete", "label": "main story completes" },
    { "do": "expect", "js": "!!document.querySelector('#gf-retry')", "op": "truthy", "label": "ending screen is shown" },
    { "do": "screenshot", "name": "05-ending" }
  ]
}
