{
  "name": "Ashen Vale",
  "serveRoot": "../..",
  "quality": "low",
  "steps": [
    { "do": "step", "frames": 30 },
    { "do": "expect", "path": "state", "op": "==", "value": "menu", "label": "title menu is shown on boot" },
    { "do": "screenshot", "name": "01-title" },
    { "do": "call", "fn": "startGame" },
    { "do": "step", "frames": 60 },
    { "do": "expect", "path": "state", "op": "==", "value": "playing", "label": "New Game enters gameplay" },
    { "do": "expect", "path": "player.grounded", "op": "truthy", "label": "player stands on terrain" },
    { "do": "canvas", "label": "gameplay frame is rendered (not blank)" },
    { "do": "hold", "action": "moveForward" }, { "do": "step", "frames": 45 }, { "do": "release", "action": "moveForward" },
    { "do": "expect", "path": "player.z", "op": "<", "value": 16.5, "label": "W moves the player forward (camera-relative)" },
    { "do": "press", "action": "jump", "frames": 2 }, { "do": "step", "frames": 8 },
    { "do": "expect", "path": "player.grounded", "op": "falsy", "label": "Space makes the player jump" },
    { "do": "step", "frames": 60 },
    { "do": "expect", "path": "player.grounded", "op": "truthy", "label": "player lands again" },
    { "do": "step", "frames": 140 },
    { "do": "expect", "path": "wave", "op": ">=", "value": 1, "label": "first enemy wave spawns" },
    { "do": "expect", "path": "enemiesAlive", "op": ">=", "value": 3, "label": "enemies are alive" },
    { "do": "expect", "js": "window.__GF.state().enemyStates.some(s => s === 'chase' || s === 'attack' || s === 'circle')", "op": "truthy", "label": "enemy AI perceives and pursues the player" },
    { "do": "eval", "js": "window.__GF.cheat.god()" },
    { "do": "press", "action": "attack", "frames": 2, "every": 18, "repeat": 30 },
    { "do": "expect", "path": "stats.damageDealt", "op": ">", "value": 0, "label": "melee combo damages enemies" },
    { "do": "expect", "path": "kills", "op": ">=", "value": 1, "label": "enemies can be killed" },
    { "do": "screenshot", "name": "02-combat" },
    { "do": "press", "action": "dodge", "frames": 2 }, { "do": "step", "frames": 4 },
    { "do": "expect", "path": "player.anim", "op": "==", "value": "dodge", "label": "dodge roll plays" },
    { "do": "step", "frames": 40 },
    { "do": "press", "action": "ability", "frames": 2 }, { "do": "step", "frames": 30 },
    { "do": "expect", "path": "stats.damageDealt", "op": ">", "value": 30, "label": "shockwave ability works" },
    { "do": "eval", "js": "window.__GF.cheat.killAll()" }, { "do": "step", "frames": 300 },
    { "do": "expect", "path": "wave", "op": ">=", "value": 2, "label": "clearing a wave starts the next" },
    { "do": "eval", "js": "window.__GF.cheat.skipToWave(5)" }, { "do": "step", "frames": 30 },
    { "do": "expect", "path": "wave", "op": "==", "value": 5, "label": "final wave reached" },
    { "do": "step", "frames": 90 },
    { "do": "expect", "path": "boss", "op": ">", "value": 0, "label": "boss wave spawns the Warden" },
    { "do": "screenshot", "name": "03-boss" },
    { "do": "eval", "js": "window.__GF.cheat.killAll()" }, { "do": "step", "frames": 300 },
    { "do": "expect", "path": "state", "op": "==", "value": "gameover", "label": "defeating the boss ends the game in victory" },
    { "do": "step", "frames": 150 },
    { "do": "expect", "js": "!!document.querySelector('#gf-retry')", "op": "truthy", "label": "victory screen offers Play Again" },
    { "do": "screenshot", "name": "04-victory" },
    { "do": "call", "fn": "startGame" }, { "do": "step", "frames": 30 },
    { "do": "eval", "js": "window.__GF.cheat.damagePlayer(1e9)" }, { "do": "step", "frames": 120 },
    { "do": "expect", "path": "state", "op": "==", "value": "gameover", "label": "player death leads to game over" }
  ]
}
